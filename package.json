{
  "name": "design-patterns-ts",
  "version": "1.0.0",
  "description": "Implementação dos 23 Design Patterns GoF em TypeScript.",
  "type": "module",
  "private": true,
  "workspaces": [
    "patterns/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "rm -rf dist node_modules && npm run clean:patterns",
    "clean:patterns": "find patterns -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find patterns -name 'dist' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/ui": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=24.8.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iKohlVictor/design-patterns-ts.git"
  },
  "keywords": [
    "design-patterns",
    "gof",
    "typescript",
    "patterns",
    "software-architecture",
    "clean-code"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/iKohlVictor/design-patterns-ts/issues"
  },
  "homepage": "https://github.com/iKohlVictor/design-patterns-ts#readme"
}
